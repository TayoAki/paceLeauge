# Copy to .env.local (git-ignored) and fill in. Only public values belong here: everything
# prefixed EXPO_PUBLIC_ ships inside the app. The API key only identifies the app; every
# RPC is protected by row-level security and server-side identity checks.

# development | staging | production (non-production builds show the environment in the app name)
EXPO_PUBLIC_APP_ENV=development

# The PaceLeague API (server/, deployed on Railway): its public URL and PUBLIC_API_KEY.
# Local dev backend: EXPO_PUBLIC_API_URL=http://127.0.0.1:54400 and EXPO_PUBLIC_API_KEY=pl_dev_public_key
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_KEY=

# Operator facts required before an external pilot (see docs/STATUS.md → launch blockers).
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# The web app's public URL (docs/ROADMAP.md P.2), used in links people open anywhere, such as
# follow links. Leave empty to share app links (paceleague://) instead.
EXPO_PUBLIC_WEB_URL=

# Native identifiers. The defaults are in app.config.ts: the App Store app com.tayoaki.paceleague
# (development builds use com.tayoaki.paceleague.dev) in the Expo project @tayom/paceleague.
# Set these only to override them.
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=
EAS_PROJECT_ID=

# Pro (docs/ROADMAP.md 3.6): RevenueCat's public SDK keys from its dashboard (Project → API keys).
# Public by design, like the API key above. Leave empty to hide purchases.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Maps (docs/ROADMAP.md 5.1 and 5.2). A Google Maps SDK key for Android builds, restricted to the
# app's package and signing certificates (without it Android draws routes on a grid). Offline map
# areas with Mapbox: PL_MAPBOX=1 links the SDK into the build, and a public Mapbox token (pk.…)
# turns them on. Leave empty to keep them off.
GOOGLE_MAPS_ANDROID_KEY=
PL_MAPBOX=
EXPO_PUBLIC_MAPBOX_TOKEN=
