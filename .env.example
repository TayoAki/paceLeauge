# Copy to .env.local (git-ignored) and fill in. Only public values belong here:
# the Supabase anon key is designed to ship in the app; every table and RPC is
# protected by RLS and explicit identity checks. NEVER add a service-role key.

# development | staging | production (non-production builds show the environment in the app name)
EXPO_PUBLIC_APP_ENV=development

# Supabase project (Project Settings → API). For the local dev backend use http://127.0.0.1:54400
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Operator facts required before an external pilot (see docs/STATUS.md → launch blockers).
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Native identifiers owned by the founder's developer organization.
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=
EAS_PROJECT_ID=
