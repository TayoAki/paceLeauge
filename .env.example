# Copy to .env.local (git-ignored) and fill in. Only public values belong here: everything
# prefixed EXPO_PUBLIC_ ships inside the app. The API key only identifies the app; every
# RPC is protected by row-level security and server-side identity checks.

# development | staging | production (non-production builds show the environment in the app name)
EXPO_PUBLIC_APP_ENV=development

# The PaceLeague API (server/, deployed on Railway): its public URL and PUBLIC_API_KEY.
# Local dev backend: EXPO_PUBLIC_API_URL=http://127.0.0.1:54400 and EXPO_PUBLIC_API_KEY=pl_dev_public_key
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_KEY=

# Operator facts required before an external pilot (see docs/STATUS.md → launch blockers).
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Native identifiers owned by the founder's developer organization.
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=
EAS_PROJECT_ID=
