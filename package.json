{
  "name": "paceleague",
  "version": "0.1.0",
  "private": true,
  "description": "PaceLeague — a private running league: record runs, earn permanent XP, compete with your crew's best three days.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --selectProjects unit",
    "test:db": "bash scripts/db/test-db.sh",
    "test:all": "npm test && npm run test:db",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:secrets && npm test",
    "db:local": "bash scripts/db/local-db.sh",
    "dev:backend": "tsx scripts/dev-backend/server.ts",
    "smoke:api": "tsx scripts/smoke/api-smoke.ts",
    "export:web": "expo export --platform web",
    "e2e:web": "node scripts/e2e/web-walkthrough.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/metro-runtime": "~57.0.16",
    "@garmin/fitsdk": "^21.217.0",
    "@kingstinct/react-native-healthkit": "^16.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.103.3",
    "expo": "~57.0.25",
    "expo-age-range": "^57.0.5",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.20",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "pg": "^8.23.0",
    "playwright-core": "1.56.1",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
